# Copy to .env locally. Never put real credentials in tracked files.
PFA_ENVIRONMENT=development
PFA_LOG_LEVEL=INFO
# Relative to the current working directory; run commands from the repository.
PFA_PROJECT_ROOT=.
# Real imports need a stable secret key from protected storage (64 random hex digits).
# PFA_FINGERPRINT_KEY=
# STEP13: database/API secrets are read from process environment only, not this file.
# PFA_DB_MODE=SYNTHETIC
# PFA_DB_URL=                  # Protected postgresql+psycopg URL; never commit credentials.
# PFA_DB_POOL_SIZE=2
# PFA_DB_MAX_OVERFLOW=0
# PFA_DB_POOL_TIMEOUT=5
# PFA_API_MODE=DEMO_ONLY
# PFA_API_PRINCIPALS=          # Protected JSON credential array; see docs/RBAC_MATRIX.md.
# TEST_DATABASE_URL=           # Dedicated local PostgreSQL database ending in _test.
# Optional compose.postgres.yaml: protected PFA_POSTGRES_USER/PASSWORD/DATABASE.
# STEP14 dashboard reads these from protected process environment only.
# PFA_DASHBOARD_API_URL=http://127.0.0.1:8000
# PFA_DASHBOARD_API_KEY=       # Use a source-scoped ANALYST principal; never commit a key.
# STEP16: opt-in restricted ADMIN operational status; not read as a secret from this file.
# PFA_API_OBSERVABILITY_ENABLED=false
# STEP17: release api creates owned temporary SQLite; never uses PFA_DB_URL/pfa_test.
# Inject PFA_API_MODE=DEMO_ONLY and protected role credentials as documented in DEMO_QUICKSTART.md.
